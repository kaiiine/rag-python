# ==============================================================================
# .dockerignore - Fichiers à exclure lors de la construction Docker
# ==============================================================================

# Environnements virtuels Python
venv/
env/
.venv/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Fichiers de développement
.git/
.gitignore
*.md
README.md

# IDE et éditeurs
.vscode/
.idea/
*.swp
*.swo

# Logs et fichiers temporaires
*.log
*.tmp
*.temp

# Modèles d'embedding (seront téléchargés dans le container)
embedding_models/
embedding_model/

# Base de données vectorielle locale
chrome_langchain_db/

# Fichiers de données volumineux (à monter en volume)
data/
pdfs/

# Fichiers OS
.DS_Store
Thumbs.db

# Fichiers de test
tests/
test_*.py

# Fichiers Docker
Dockerfile*
docker-compose*.yml
